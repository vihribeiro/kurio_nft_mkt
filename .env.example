# ---------------------------------------------------------------------------
# Kurio — variáveis de ambiente
#
# Copie para `.env.local` e ajuste. Todos os valores abaixo são fictícios e
# seguros: o projeto roda inteiro com mocks, sem backend real.
# ---------------------------------------------------------------------------

# Base URL da API REST simulada (o MSW intercepta este prefixo).
VITE_API_URL=https://api.kurio.local

# Caminho do endpoint Socket.IO. Fica na mesma origem do app — em
# desenvolvimento e em produção — porque o binding de tempo real do MSW
# intercepta a conexão dentro do navegador, sem tocar a rede real.
VITE_SOCKET_PATH=/socket.io

# Liga/desliga o Mock Service Worker.
# `true`  -> HTTP e WebSocket são servidos pelos mocks locais (padrão).
# `false` -> tenta falar com os serviços reais definidos acima.
VITE_ENABLE_MOCKS=true

# Cenário de simulação ativo no boot (ex.: happy-path, frozen-prices).
# Ex.: happy-path | empty-catalog | checkout-error | slow-network | frozen-prices
VITE_MOCK_SCENARIO=happy-path

# Exibe a barra de troca de cenário (usada na demonstração e nos testes).
VITE_ENABLE_SCENARIO_SWITCHER=true
